{{- /* 全文检索索引：每日简报拆成单条资讯（链接直达条目锚点）+ 保留整页（行情表等） */ -}}
{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
{{- if and (not .Params.searchHidden) (ne .Layout "archives") (ne .Layout "search") -}}
{{- $page := . -}}
{{- $section := .Section -}}
{{- $sectionLabel := index site.Params.sectionShort $section | default .Title -}}
{{- $date := .Date.Format "2006-01-02" -}}
{{- $meta := printf "%s · %s" $sectionLabel $date -}}
{{- $raw := .RawContent -}}

{{- /* ### N. 标题 条目（AI / 国际 / 财经要闻 / 研报 / 深度） */ -}}
{{- $blocks := split $raw "\n### " -}}
{{- if gt (len $blocks) 1 -}}
{{- range $i, $block := $blocks -}}
{{- if gt $i 0 -}}
{{- $lines := split $block "\n" -}}
{{- $rawHeading := index $lines 0 | strings.TrimSpace -}}
{{- /* 新日报标题自带 {#i-…} 锚点；旧日报按标题文字生成锚点 */ -}}
{{- $anchor := replaceRE `^.*\{#([\w-]+)\}$` "$1" $rawHeading -}}
{{- $rawHeading = replaceRE `\s*\{#[\w-]+\}$` "" $rawHeading -}}
{{- if eq $anchor (index $lines 0 | strings.TrimSpace) }}{{ $anchor = anchorize $rawHeading }}{{ end -}}
{{- $heading := replaceRE `^\d+\.\s*` "" $rawHeading -}}
{{- $heading = replaceRE `^【重点】` "" $heading -}}
{{- $heading = strings.TrimSpace $heading -}}
{{- $body := delimit (after 1 $lines) "\n" -}}
{{- /* 截断到下一个二级标题，避免把后续分区并入本条 */ -}}
{{- $body = index (split $body "\n## ") 0 -}}
{{- $plain := $body | plainify | htmlUnescape | strings.TrimSpace -}}
{{- if $heading -}}
{{- $link := printf "%s#%s" $page.Permalink $anchor -}}
{{- $.Scratch.Add "index" (dict "title" $heading "content" $plain "permalink" $link "summary" $meta "section" $section) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- /* 巨潮公告列表项：- 公司：[标题](url) */ -}}
{{- range findRE `(?m)^-\s+[^：:\n]+[：:]\s*\[[^\]]+\]\([^)]+\)` $raw -}}
{{- $line := . -}}
{{- $company := replaceRE `(?s)^-\s+([^：:]+)[：:].*$` "$1" $line | strings.TrimSpace -}}
{{- $title := replaceRE `(?s)^.*\[([^\]]+)\].*$` "$1" $line | strings.TrimSpace -}}
{{- $entryTitle := printf "%s：%s" $company $title -}}
{{- $link := printf "%s#%s" $page.Permalink (anchorize (cond (eq site.Language.Lang "en") "Filings & research" "公告与研报")) -}}
{{- $.Scratch.Add "index" (dict "title" $entryTitle "content" $entryTitle "permalink" $link "summary" (printf "%s · %s · %s" $sectionLabel (i18n "filings") $date) "section" $section) -}}
{{- end -}}

{{- /* 整页兜底：行情表、宏观日历、未拆分内容均可搜 */ -}}
{{- $.Scratch.Add "index" (dict "title" .Title "content" .Plain "permalink" .Permalink "summary" (.Params.summary | default $meta) "section" $section) -}}

{{- end -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
